        for table_name, csv_name in TABLE_FILES.items():
            csv_path = csv_root / csv_name
            frame = pd.read_csv(csv_path)
            frame.to_sql(table_name, conn, if_exists="replace", index=False)
            print(f"Loaded {table_name:<18} rows={len(frame):>4} from {csv_name}")

    print(f"\nSQLite database built at: {db_path}")


if __name__ == "__main__":
    main()

