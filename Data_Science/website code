from __future__ import annotations

import argparse
import sqlite3
from pathlib import Path

import pandas as pd


TABLE_FILES = {
    "institutions": "institutions.csv",
    "programs": "programs.csv",
    "courses": "courses.csv",
    "knowledge_units": "knowledge_units.csv",
    "course_ku": "course_ku.csv",
